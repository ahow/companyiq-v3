# CompanyIQ v3 — environment variable reference (.env.example)
#
# Copy to `.env` and fill in real values. All feature flags below are
# DEFAULT-ON: the behaviour is active unless the variable is explicitly set to
# the string "false". Numeric tuning knobs fall back to the documented default
# when unset or unparseable. Nothing here needs to be set for normal operation;
# they exist so each behaviour can be independently disabled or tuned.

# ---------------------------------------------------------------------------
# Core runtime (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by server/db.ts.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---------------------------------------------------------------------------
# R3 — Provenance robustness
# Master flag for three provenance behaviours: (1) fail-open on the U17 issuer
# exclusion when the company domain is empty/unconfirmed at scoring time,
# (2) broadened multi-token brand-token rescue in provenance.ts (Rule 1b),
# (3) high-exclusion-ratio empty-pack refill trigger. Set to "false" to
# restore the exact pre-R3 behaviour.
# ---------------------------------------------------------------------------
# Default: on (any value except "false" keeps it on).
PROVENANCE_ROBUSTNESS=true
# Fraction (0 < r <= 1) of corpus content chars that provenance exclusion must
# drop before the empty-pack refill is triggered even when some docs survive.
# Only active while PROVENANCE_ROBUSTNESS is on. Default: 0.8 (80%).
PROVENANCE_EXCLUSION_REFILL_RATIO=0.8

# ---------------------------------------------------------------------------
# R1 — Corpus-readiness barrier + bounded re-fetch
# Before snapshot/scoring, require the PRIMARY tier of gate-accepted docs to be
# fetched. If primaries were discovered but none fetched, attempt a bounded
# re-fetch; if still absent, mark "Insufficient corpus (primaries missing)" and
# refuse to score. Gates ONLY on fetch completeness of the input corpus.
# ---------------------------------------------------------------------------
# Default: on. Set to "false" to skip the readiness barrier entirely.
CORPUS_READINESS_BARRIER=true
# Max number of primary docs to bounded-re-fetch when primaries are missing.
# Default: 3.
CORPUS_READINESS_REFETCH_MAX=3

# ---------------------------------------------------------------------------
# R4 — Loud empty-corpus signal
# When the corpus yields zero usable chunks across ALL measures, emit a
# machine-readable emptyCorpus diagnostic (passage-retrieval sentinel packs +
# an end-of-pipeline AnalysisResult.emptyCorpus signal) so an operational
# "empty corpus" is distinguishable from a topic that is genuinely absent.
# ---------------------------------------------------------------------------
# Default: on. Set to "false" to emit sentinel packs with no diagnostics
# (exact pre-R4 behaviour).
LOUD_EMPTY_CORPUS=true

# ---------------------------------------------------------------------------
# Auto-rerun — bounded zero-corpus re-run (replaces the old static R5 floor)
# On the R4 empty-corpus signal, convert the silent "success with all-No"
# outcome into a RETRIABLE failure and re-enqueue re-examination, capped by a
# DEDICATED counter (separate from the worker's general retry budget). Does NOT
# fire when the company domain is unresolved (quarantine) or when the corpus is
# anti-bot-stub-dominated AND no residential proxy is configured; when the
# EVOMI proxy is configured, stub-dominated corpora become eligible.
# ---------------------------------------------------------------------------
# Default: on. Set to "false" to disable the zero-corpus re-run entirely.
ZERO_CORPUS_RERUN=true
# Max number of zero-corpus re-runs per company before marking "Insufficient
# corpus" (not scored). Separate from MAX_RETRY_ATTEMPTS. Default: 2.
MAX_ZERO_CORPUS_RERUNS=2
# A fetched document with fewer than this many content chars is treated as an
# anti-bot / placeholder stub for stub-dominance detection. Default: 500.
ZERO_CORPUS_STUB_MAX_CHARS=500

# ---------------------------------------------------------------------------
# Residential proxy (Evomi) — context for the zero-corpus re-run gating above.
# BOTH must be set for the proxy to be considered "configured": only then does
# a stub-dominated (anti-bot) corpus become eligible for the zero-corpus
# re-run instead of being quarantined.
# ---------------------------------------------------------------------------
EVOMI_PROXY_USER=
EVOMI_PROXY_PASS=

# ---------------------------------------------------------------------------
# Related existing knobs (not introduced by R1/R3/R4/rerun, listed for context)
# ---------------------------------------------------------------------------
# CORPUS_HYGIENE / U17 provenance filtering and other retrieval tuning knobs
# (RETRIEVAL_CORPUS_MAX_CHARS, RETRIEVAL_EVIDENCE_MAX_CHARS, etc.) are
# documented at their definitions in server/lib/*. They are unaffected by the
# R1/R3/R4/rerun changes.
